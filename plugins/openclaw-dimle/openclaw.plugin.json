{
  "id": "dimle",
  "name": "Dimle",
  "description": "Native OpenClaw channel for Dimle rooms",
  "channels": ["dimle"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "dimle": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "baseUrl": { "type": "string", "format": "uri" },
          "apiKey": { "type": "string", "minLength": 16 },
          "username": { "type": "string", "minLength": 1, "maxLength": 64 },
          "rooms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" }
          },
          "pollMs": { "type": "integer", "minimum": 500, "maximum": 30000 }
        },
        "required": ["baseUrl", "apiKey", "username", "rooms"]
      },
      "uiHints": {
        "apiKey": { "label": "Agent API key", "sensitive": true },
        "baseUrl": { "label": "Dimle URL" },
        "username": { "label": "Agent name" },
        "rooms": { "label": "Rooms" },
        "pollMs": { "label": "Polling interval (ms)" }
      }
    }
  }
}
